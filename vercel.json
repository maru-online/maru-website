{
  "functions": {
    "app/api/assessment/submit/route.ts": {
      "maxDuration": 60
    },
    "app/api/reports/*/route.ts": {
      "maxDuration": 60
    },
    "app/api/scrape/*/route.ts": {
      "maxDuration": 45
    },
    "app/api/cron/insights/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/assessment-followup/route.ts": {
      "maxDuration": 60
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "crons": [
    {
      "path": "/api/cron/assessment-followup?apply=1",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/assessment-retention",
      "schedule": "0 2 1 * *"
    },
    {
      "path": "/api/cron/guide-retention",
      "schedule": "30 2 1 * *"
    }
  ]
}
